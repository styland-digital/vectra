      "Bash(alembic *)",
      "Bash(docker *)",
      "Bash(curl *)",
      "Bash(test:*)",
      "Bash(node --version:*)",
      "Bash(docker-compose:*)",
      "Bash(python3.11:*)",
      "Bash(make:*)",
      "Bash(source:*)",
      "Bash(pip install:*)",
      "Bash(python3.12:*)",
      "Bash(python3.10:*)",
      "Bash(where:*)",
      "Bash(..\\\\.venvScriptsactivate)",
      "Bash(\".venv/Scripts/python.exe\" --version)",
      "Bash(py:*)",
      "Bash(..\\\\venv_new\\\\Scripts\\\\python.exe --version)",
      "Bash(\"./venv_new/Scripts/python.exe\" --version)",
      "Bash(\"../venv_new/Scripts/python.exe\" -m pip install -r requirements.txt)",
      "Bash(\"../venv_new/Scripts/python.exe\" -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000)",
