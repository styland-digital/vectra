      "Bash(.venvScriptspython.exe -c \"from app.core.security import create_access_token, decode_token; print\\(''Security OK''\\)\")",
      "Bash(.venvScriptspython.exe -c \"from app.api.deps import get_db, oauth2_scheme; print\\(''Deps OK''\\)\")",
      "Bash(docker ps:*)",
