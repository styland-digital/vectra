							"mode": "raw",
							"raw": "{\n  \"email\": \"john.doe@acme.com\",\n  \"password\": \"SecurePass123!\",\n  \"full_name\": \"John Doe\",\n  \"organization_name\": \"Acme Corp\"\n}"
